
import SwiftUI

struct ContentView: View {
    var body: some View {
        VStack(spacing: 20) {
            Text("Arithmetic Calculator")
                .font(.system(size: 30, weight: .bold))

            Text("Number 1 = 10")
            Text("Number 2 = 15")

            Divider()

            Text("Addition: \(10 + 15)")
            Text("Subtraction: \(10 - 15)")
            Text("Multiplication: \(10 * 15)")
            Text("Division: \(10.0 / 15.0)")
            Text("Remainder: \(10 % 15)")
        }
        .font(.system(size: 22))
        .padding()
    }
}
